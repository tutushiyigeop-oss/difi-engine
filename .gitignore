# ==================================================
# Vitis 2024.2 Workspace
# ==================================================

# Original Vitis workspace: ignore generated files, but keep
# hand-written application C/H sources inside component src/.
/vitis/vitis_ws/**
!/vitis/vitis_ws/*/
!/vitis/vitis_ws/*/src/
!/vitis/vitis_ws/*/src/**/
!/vitis/vitis_ws/*/src/**/*.c
!/vitis/vitis_ws/*/src/**/*.h

# Rebuilt Vitis workspace is a disposable verification output.
# All regenerated platform/BSP/build and copied source files are ignored.
/vitis/vitis_ws_rebuilt/

# Windows system files
desktop.ini

